# Server
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=quantuser
DB_PASSWORD=quantpass
DB_NAME=quantintel
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Valkey
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_DB=0

# LLM Provider
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.0-flash

# Ingestion
INGESTION_WORKERS=10
INGESTION_RATE_LIMIT_RPS=5
INGESTION_RETRY_MAX=3
