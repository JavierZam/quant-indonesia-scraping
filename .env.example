# Server
SERVER_PORT=8080

# PostgreSQL / Supabase
# Local: postgres://quantuser:quantpass@localhost:5432/quantintel?sslmode=disable
# Supabase: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=quantuser
DB_PASSWORD=quantpass
DB_NAME=quantintel
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DATABASE_URL=postgres://quantuser:quantpass@localhost:5432/quantintel?sslmode=disable

# Valkey
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_DB=0

# LLM Provider (Support comma-separated keys for auto-failover & high throughput: key1,key2,key3)
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-1,your-api-key-2
LLM_MODEL=gemini-2.5-flash

# Ingestion
INGESTION_WORKERS=10
INGESTION_RATE_LIMIT_RPS=5
INGESTION_RETRY_MAX=3

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
